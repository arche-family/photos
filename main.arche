/// Photos, the Arche phone's gallery, written in Arche, as Android's is:
/// the pictures in the phone's shared Pictures folder, the newest first
/// (a camera names them by when they were taken), as a grid; a tap on one
/// shows it whole, with its name, Back and Delete. A picture the camera
/// takes while the app is behind is there when it comes back. An app of
/// the page: its taps come as click events.
///
/// An app of the phone's world (arche:phone, wit/): it reads the shared
/// files through files (its manifest's needs: files), and hands each PNG
/// to the shell to decode (image-load), drawn by its number.
import alloc;
import dom;
import files;
import host_api;
import std;

const SHEET: str = "body { padding: 0; } .app { display: flex; flex-direction: column; gap: 12px; padding: 16px; } h1 { font-size: 30px; color: var(--nimadir-text); } .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; } button.cell { padding: 0; border: 0; border-radius: 6px; background: var(--nimadir-surface); } img.thumb { width: 100%; } .none { font-size: 16px; color: var(--nimadir-muted); } .view { display: flex; flex-direction: column; gap: 12px; } img.full { width: 100%; } .name { font-size: 15px; color: var(--nimadir-muted); } .bar { display: flex; flex-direction: row; gap: 12px; } button { padding: 12px 20px; border-radius: 24px; font-size: 16px; border: 0; background: var(--nimadir-accent-wash); color: var(--nimadir-text); } .hidden { display: none; }";

const FOLDER: str = "Pictures";

/// A picture: its file's name, and the shell's number for it.
type Picture = struct {
    name: alloc.String,
    handle: u32,
}

type Photos = struct {
    /// The pictures, the newest first.
    all: alloc.List(Picture),
    /// The picture shown whole; "" for the grid.
    shown: alloc.String,
    /// The page's nodes.
    list: u32,
    grid: u32,
    empty: u32,
    view: u32,
    full: u32,
    name: u32,
}

fn init(host: &mut std.Host, a: alloc.Allocator) -> Photos {
    _ = dom.add_stylesheet(host, css: SHEET);
    let root = dom.root(host);
    let markup = "<div class='app'><div class='list'><h1>Photos</h1><div class='none'>No photos yet</div><div class='grid'></div></div><div class='view hidden'><img class='full'><div class='name'></div><div class='bar'><button data-k='close'>Back</button><button data-k='delete'>Delete</button></div></div></div>";
    var why = alloc.String.init(a);
    if not dom.set_markup(host, item: root, markup: markup, why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
    let app = first(host, selector: ".app", a: a);
    dom.listen(host, item: app, kind: "click");
    var state = Photos {
        all: alloc.List(Picture).init(a),
        shown: alloc.String.init(a),
        list: first(host, selector: ".list", a: a),
        grid: first(host, selector: ".grid", a: a),
        empty: first(host, selector: ".none", a: a),
        view: first(host, selector: ".view", a: a),
        full: first(host, selector: ".full", a: a),
        name: first(host, selector: ".name", a: a),
    };
    if look(&mut state, host: host, a: a) {
        show(&mut state, host: host, a: a);
    }
    return state;
}

fn update(state: &mut Photos, host: &mut std.Host, a: alloc.Allocator) {
    var changed = look(state, host: host, a: a);
    for e in dom.events(host, a: a).items() {
        if e.kind.view().eq("click") {
            match key_of(host, n: e.target, a: a) {
                some(k) => {
                    press(state, host: host, key: k.view(), a: a);
                    changed = true;
                }
                none => { }
            }
        }
    }
    if changed {
        show(state, host: host, a: a);
    }
}

/// Whether name is a PNG's.
fn is_png(name: str) -> bool {
    let n = name.len();
    return n > 4 and (name[n - 4..n].eq(".png") or name[n - 4..n].eq(".PNG"));
}

/// The Pictures folder looked at again: a picture new to the app loaded,
/// one gone dropped. Whether anything changed.
fn look(state: &mut Photos, host: &mut std.Host, a: alloc.Allocator) -> bool {
    let found = files.list(host, path: FOLDER, a: a);
    var names = alloc.List(alloc.String).init(a);
    // The newest first: the names, a camera's, in the order of when.
    var k = found.len();
    while k > 0 {
        k -= 1;
        let e = &found.items()[k];
        if not e.folder and is_png(e.name.view()) {
            names.push(alloc.String.from(e.name.view(), a));
        }
    }
    var same = names.len() == state.all.len();
    var i: usize = 0;
    while same and i < names.len() : (i += 1) {
        if not names.items()[i].view().eq(state.all.items()[i].name.view()) {
            same = false;
        }
    }
    if same {
        return false;
    }
    var now = alloc.List(Picture).init(a);
    for n in names.items() {
        var handle: u32 = 0;
        var known = false;
        for p in state.all.items() {
            if p.name.view().eq(n.view()) {
                handle = p.handle;
                known = true;
            }
        }
        if not known {
            var path = alloc.String.from(FOLDER, a);
            path.push_str("/");
            path.push_str(n.view());
            match files.read(host, path: path.view(), a: a) {
                some(bytes) => {
                    var why = alloc.String.init(a);
                    match host_api.image_load(host, bytes: bytes.items(), why: &mut why, a: a) {
                        some(h) => {
                            handle = h;
                            known = true;
                        }
                        none => { host_api.log(host, msg: why.view()); }
                    }
                }
                none => { }
            }
        }
        if known {
            now.push(Picture { name: alloc.String.from(n.view(), a), handle: handle });
        }
    }
    state.all = now;
    return true;
}

fn press(state: &mut Photos, host: &mut std.Host, key: str, a: alloc.Allocator) {
    if key.starts_with("p:") {
        state.shown = alloc.String.from(key[2..key.len()], a);
    } else if key.eq("close") {
        state.shown = alloc.String.init(a);
    } else if key.eq("delete") {
        var path = alloc.String.from(FOLDER, a);
        path.push_str("/");
        path.push_str(state.shown.view());
        _ = files.remove(host, path: path.view());
        state.shown = alloc.String.init(a);
        _ = look(state, host: host, a: a);
    }
}

/// The page as it is: the grid, or the picture shown whole.
fn show(state: &mut Photos, host: &mut std.Host, a: alloc.Allocator) {
    for p in state.all.items() {
        if state.shown.len() > 0 and p.name.view().eq(state.shown.view()) {
            var src = alloc.String.init(a);
            src.push_u64(p.handle as u64);
            dom.set_attribute(host, item: state.full, name: "src", value_: src.view());
            dom.set_text(host, item: state.name, text: p.name.view());
            dom.toggle_class(host, item: state.list, name: "hidden", on: true);
            dom.toggle_class(host, item: state.view, name: "hidden", on: false);
            return;
        }
    }
    state.shown = alloc.String.init(a);
    dom.toggle_class(host, item: state.view, name: "hidden", on: true);
    dom.toggle_class(host, item: state.list, name: "hidden", on: false);
    dom.toggle_class(host, item: state.empty, name: "hidden", on: state.all.len() > 0);
    for old in dom.children(host, item: state.grid, a: a).items() {
        dom.release(host, item: old.*);
    }
    for p in state.all.items() {
        let cell = dom.create_element(host, tag: "button");
        dom.set_attribute(host, item: cell, name: "class", value_: "cell");
        var k = alloc.String.from("p:", a);
        k.push_str(p.name.view());
        dom.set_attribute(host, item: cell, name: "data-k", value_: k.view());
        let img = dom.create_element(host, tag: "img");
        dom.set_attribute(host, item: img, name: "class", value_: "thumb");
        var src = alloc.String.init(a);
        src.push_u64(p.handle as u64);
        dom.set_attribute(host, item: img, name: "src", value_: src.view());
        dom.set_attribute(host, item: img, name: "alt", value_: p.name.view());
        dom.append_child(host, parent_: cell, child: img);
        dom.append_child(host, parent_: state.grid, child: cell);
    }
}

/// The first node under the page that selector finds; 0 for none.
fn first(host: &mut std.Host, selector: str, a: alloc.Allocator) -> u32 {
    let found = dom.query_all(host, scope: dom.root(host), selector: selector, a: a);
    if found.len() == 0 {
        return 0;
    }
    return found.items()[0];
}

/// The key a click on n is: its data-k, or its nearest ancestor's.
fn key_of(host: &mut std.Host, n: u32, a: alloc.Allocator) -> ?alloc.String {
    var at = n;
    var hops: u32 = 0;
    while at != 0 and hops < 8 : (hops += 1) {
        match dom.get_attribute(host, item: at, name: "data-k", a: a) {
            some(k) => { return k; }
            none => { }
        }
        at = dom.parent(host, item: at) orelse 0;
    }
    return none;
}
