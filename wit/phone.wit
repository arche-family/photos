// The Arche phone's world (docs/sprints.md T5, T6, T7): Nimadir's, and what a
// phone gives an app more. An app of it is built as Nimadir's are
// (arche-lang's wasm/nimadir-app.sh), with this directory as its wit/ and
// phone-app as its world; Nimadir's own world is in deps/.
package arche:phone@0.1.0;

/// Notifications: what an app tells its user while it is not looked at.
/// They are in the shade, and one that comes is shown over the top of the
/// screen for a while; a tap on one opens its app. Only for an app whose
/// manifest needs notify (T8); another's post posts nothing.
interface notify {
    /// A notification of title and text; its number, to cancel it by.
    post: func(title: string, text: string) -> u32;
    /// The app's notification of that number taken away.
    cancel: func(id: u32);
}

/// An app woken off the screen, as an alarm or a messenger is: the phone
/// runs its update once then, for at most 2 s, and what it draws is not
/// shown; it may post a notification, and ask to be woken again. Only for
/// an app whose manifest needs background (T8); another's wake-at wakes
/// nothing.
interface background {
    /// Wake this app at about at-millis (as now-millis counts): one time an
    /// app, a later call replacing it; 0 asks for none. The phone keeps it
    /// across a restart.
    wake-at: func(at-millis: s64);
    /// Whether this init or update is such a wake.
    woken: func() -> bool;
}

/// Calls (T6): a number dialed, the phone's call screen takes it from
/// there, as Android's in-call screen does. Only for an app whose
/// manifest needs telephony; another's dial does nothing.
interface telephony {
    dial: func(number: string);
    /// A call the phone had (T7): the other end's number, whether it came
    /// or was made, whether it was answered (a call that came and was not
    /// is a missed one), when it began, as now-millis counts, and how
    /// long it went on.
    record call {
        number: string,
        incoming: bool,
        answered: bool,
        at-millis: s64,
        seconds: u32,
    }
    /// The calls the phone had, the oldest first.
    history: func() -> list<call>;
}

/// Text messages (T6): those the phone has, and one sent. Only for an app
/// whose manifest needs messaging; another's list is empty, and its send
/// sends nothing.
interface messaging {
    record message {
        number: string,
        text: string,
        /// Whether it came to the phone, or went from it.
        incoming: bool,
    }
    /// The messages, the oldest first.
    list: func() -> list<message>;
    /// text sent to number; it is in list once it has gone.
    send: func(number: string, text: string);
}

/// Where the phone is (T6), when it knows: degrees north and east. Only
/// for an app whose manifest needs location; another is told none.
interface location {
    record position {
        latitude: f64,
        longitude: f64,
    }
    position: func() -> option<position>;
}

/// The phone's contacts (T7): names for numbers, kept by the phone and
/// shared by the apps that may (their manifest's needs: contacts); the
/// call screen and messages' notifications say them too. Another app's
/// list is empty, and its save and remove do nothing.
interface contacts {
    record contact {
        name: string,
        number: string,
    }
    /// The contacts, in order of their names.
    list: func() -> list<contact>;
    /// name kept for number: a new contact, or that number's renamed.
    save: func(name: string, number: string);
    /// number's contact taken away.
    remove: func(number: string);
}

/// An alarm that rings (T7), as Android's clock's does: the phone's alarm
/// screen over all else, a dark screen lit, the time large and the label
/// under it, with Snooze and Dismiss; its sound again and again, in Do Not
/// Disturb too, until one is tapped, or ten minutes have gone and the app's
/// notification says it was missed. Snoozed, it rings again ten minutes on,
/// and the app's notification says until when meanwhile; a tap on it opens
/// the app. One alarm at a time: a later one takes the place of one ringing
/// or snoozed. Only for an app whose manifest needs alarm; another's ring
/// rings nothing.
interface alarm {
    /// The app's alarm rung, label under the time; whether it rings.
    ring: func(label: string) -> bool;
    /// When the app's snoozed alarm rings again, as now-millis counts;
    /// none when it has none.
    snoozed: func() -> option<s64>;
    /// The app's alarm, ringing or snoozed, over.
    dismiss: func();
    /// The app's alarm set to ring at at-millis (as now-millis counts),
    /// label under the time; 0 takes it away. One an app, a later call
    /// replacing it. The phone keeps it where it reads before the user's
    /// data opens, as Android's alarm clocks are (Direct Boot), and rings
    /// it at its time itself, whether the app runs or not, the phone
    /// asleep or locked since a restart. Whether it is set.
    set: func(at-millis: s64, label: string) -> bool;
    /// When the app's set alarm rings, as now-millis counts; none when it
    /// has none set, or it has rung.
    next: func() -> option<s64>;
}

/// The phone's shared files (T7): photos, music, videos (T9), documents
/// and downloads, kept by the phone in folders of their own (Pictures,
/// Music, Movies, Documents, Download), and shared by the apps that may
/// (their manifest's needs: files), as Android's shared storage is. A
/// path is names parted by "/", none of them empty, "." or ".."; "" is
/// the top, where those folders are. Any other path is refused. Another
/// app's list is empty, its read none, and its write, make-folder and
/// remove do nothing.
interface files {
    record entry {
        name: string,
        /// Whether it is a folder; a file's size in bytes, 0 for a folder.
        folder: bool,
        size: u64,
    }
    /// What is in the folder at path, in order of their names.
    list: func(path: string) -> list<entry>;
    /// The file at path; none when there is none.
    read: func(path: string) -> option<list<u8>>;
    /// data written to the file at path, made or emptied, in a folder that
    /// is there; whether it was.
    write: func(path: string, data: list<u8>) -> bool;
    /// A new folder at path; whether it was made.
    make-folder: func(path: string) -> bool;
    /// The file, or the empty folder, at path taken away; whether it was.
    remove: func(path: string) -> bool;
}

/// The phone's camera (T7): what it sees, and photos taken of it, kept in
/// the shared Pictures folder named by when they were taken, as Android's
/// camera names its photos (IMG_20261110_120000.png); and videos (T9),
/// Motion JPEG in AVI, kept in the shared Movies folder the same way
/// (VID_20261110_120000.avi). Only for an app whose manifest needs camera;
/// another's view is none, and its take takes nothing.
interface camera {
    /// What the camera sees now: the number of an image, as image-load's,
    /// which the phone keeps up to date frame by frame while the app is
    /// drawn; none when there is no camera.
    view: func() -> option<u32>;
    /// A photo of what the camera sees: in the shared Pictures folder once
    /// last says its name.
    take: func();
    /// The last photo's name in the shared Pictures folder, or the last
    /// video's in Movies; none before the first.
    last: func() -> option<string>;
    /// A video begun (T9): what the camera sees, 30 frames a second, into
    /// the shared Movies folder, until stop-video.
    start-video: func();
    /// The video ended and kept; last names it.
    stop-video: func();
    /// Whether a video is being recorded.
    recording: func() -> bool;
    /// Whether the phone has a camera on its front as well as the one on
    /// its back (T9).
    has-front: func() -> bool;
    /// The camera the view and photos come from: the one on the front, or
    /// the one on the back, as at first. Nothing changes when the phone
    /// has no such camera.
    use-front: func(front: bool);
}

/// Sound an app plays (T7): a WAV file of the phone's shared files through
/// its speaker, one at a time for the whole phone, as Android's media
/// playback is: a notification's chime pauses it a moment, and a call or
/// an alarm stops it. Only for an app whose manifest needs files, which
/// may read them; another's play plays nothing.
interface audio {
    /// The WAV file at path in the shared files played from its start, in
    /// the place of what played; whether it was asked to. What plays says
    /// whether it does.
    play: func(path: string) -> bool;
    /// What plays stopped.
    stop: func();
    /// The path of what plays, whichever app played it; none for nothing.
    playing: func() -> option<string>;
}

/// Videos (T9): a video of the shared files, Motion JPEG in AVI as the
/// camera records them, played into an image the phone keeps up to date
/// frame by frame while the app is drawn, as camera's view is; one at a
/// time an app. Only for an app whose manifest needs files.
interface video {
    /// The video at path in the shared files played from its start, in the
    /// place of one that played.
    play: func(path: string);
    /// What the video shows: the number of an image, as image-load's; none
    /// before one plays, or when path was not a video.
    view: func() -> option<u32>;
    /// Whether a video plays: false once it has ended, or was stopped. Its
    /// image keeps the frame it showed last.
    playing: func() -> bool;
    /// The video stopped.
    stop: func();
}

world phone-app {
    include nimadir:shell/mini-app@1.2.0;
    import notify;
    import background;
    import telephony;
    import messaging;
    import location;
    import contacts;
    import alarm;
    import files;
    import camera;
    import audio;
    import video;
}
